# Got Next — production settings.
# Copy to .env.production.local (git-ignored) and fill it in. Step-by-step: docs/GO_LIVE.md.
# The same values go into Vercel → Settings → Environment Variables (Production).
# Scripts that read this file: npm run check:launch, db:migrate:prod, make-admin:prod,
# supabase:configure, colleges:import.

# ---- Supabase (PRODUCTION project, Mumbai region) — Project Settings → API / Database ----
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (port 6543) for the app:
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) for migrations and scripts:
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- The site ----
NEXT_PUBLIC_SITE_URL=https://<your-domain>
AUTH_EMAIL_ENABLED=1
# Random strings: run `npm run secret` for each.
AUTH_DEVICE_SECRET=
CRON_SECRET=

# ---- Legal (shown on /privacy and /terms) ----
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_LEGAL_ENTITY=

# ---- Cloudflare Turnstile — dash.cloudflare.com → Turnstile → Add site ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Sentry — sentry.io → Project settings ----
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Optional ----
GITHUB_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=

# ---- Emergency switches (docs/INCIDENT_RESPONSE.md). Leave empty normally. ----
MAINTENANCE_MODE=
SIGNUPS_PAUSED=

# =====================================================================================
# Below: ONLY for running scripts on your machine. Do NOT add these to Vercel.
# =====================================================================================
# supabase.com/dashboard/account/tokens — for `npm run supabase:configure`
SUPABASE_ACCESS_TOKEN=
# Brevo → SMTP & API → SMTP (applied to Supabase by `npm run supabase:configure`)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=hello@<your-domain>
SMTP_SENDER_NAME=Got Next
# Google Cloud → APIs & Services → Credentials (optional, for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
