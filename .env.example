# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by the seed script and storage admin tasks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres (Project Settings → Database → Connection string) ---
# Transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session/direct connection (port 5432) — used by migrations and the seed script.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: email via Resend (leave empty to disable) ---
RESEND_API_KEY=
EMAIL_FROM="CampusSquad <noreply@example.com>"

# --- Email sign-in (links, 6-digit codes, confirmation + reset emails) ---
# Leave empty until a custom SMTP sender is set up in Supabase (docs/AUTH_SETUP.md).
# Empty  → Google + instant password sign-up (no email sent; no campus badge until Google sign-in).
# 1      → email links/codes on, sign-ups confirm their address by email.
AUTH_EMAIL_ENABLED=

# Where people send privacy requests and complaints (shown on /privacy and /terms). Required in production.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: secret for "remember this device" cookies (any long random string). Defaults to one
# derived from SUPABASE_SERVICE_ROLE_KEY; set it to sign everyone's devices out (rotate).
AUTH_DEVICE_SECRET=

# --- Optional: cron secret for /api/cron/* (deadline reminders) ---
CRON_SECRET=

# --- Optional: raises the GitHub API rate limit for "Suggest from my GitHub" (token needs no scopes) ---
GITHUB_TOKEN=

# --- Testing only. NEVER set in production. Enables /api/test-login for Playwright. ---
E2E_TEST_LOGIN=
